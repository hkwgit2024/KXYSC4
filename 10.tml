
<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no,viewport-fit=cover">
<title>枪火塔防 · 兽潮无尽</title>
<style>
*{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent;user-select:none;}
html,body{height:100%;background:#05060c;overflow:hidden;
  font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif;}
#app{position:relative;width:100vw;max-width:520px;height:100vh;height:100dvh;margin:0 auto;
  background:#0a0c16;overflow:hidden;color:#e2e8f0;}
.screen{position:absolute;inset:0;display:none;flex-direction:column;}
.screen.active{display:flex;}

/* ============ 主界面 ============ */
#menu{background:radial-gradient(ellipse at 50% 0%,#1a1f3a,#080a14 70%);}
.m-top{flex:0 0 auto;display:flex;align-items:center;gap:6px;padding:10px 12px;}
.m-res{flex:1;display:flex;align-items:center;justify-content:center;gap:4px;
  background:rgba(20,24,44,.85);border:1px solid #2a3358;border-radius:9px;
  padding:6px 4px;font-size:12px;font-weight:800;}
#mGold{color:#ffd44d;} #mGem{color:#67e8f9;}
.m-hero{flex:0 0 auto;margin:0 12px;padding:12px;border-radius:14px;
  background:linear-gradient(135deg,#1b2140,#141a30);border:1px solid #2f3a68;
  display:flex;align-items:center;gap:12px;}
.m-hero .av{width:54px;height:54px;border-radius:14px;display:flex;align-items:center;
  justify-content:center;font-size:28px;flex:0 0 auto;
  background:linear-gradient(145deg,#252c52,#171d36);border:2px solid #3d4a80;}
.m-hero .info{flex:1;min-width:0;}
.m-hero .hn{font-size:15px;font-weight:900;margin-bottom:3px;}
.m-hero .hd{font-size:10.5px;color:#7c8ab8;line-height:1.4;}
.m-tabs{flex:0 0 auto;display:flex;gap:6px;padding:10px 12px 0;}
.m-tab{flex:1;padding:9px 2px;text-align:center;font-size:12.5px;font-weight:800;
  border-radius:10px 10px 0 0;background:#12172c;color:#5c6a94;border:1px solid #232c4e;
  border-bottom:none;transition:.15s;}
.m-tab.on{background:#1d2444;color:#a5b4fc;border-color:#3d4a80;}
.m-body{flex:1;overflow-y:auto;padding:12px;-webkit-overflow-scrolling:touch;
  background:#0e1223;border-top:1px solid #232c4e;}
.tab-panel{display:none;}
.tab-panel.on{display:block;}

.sec-t{font-size:11px;color:#5c6a94;font-weight:900;letter-spacing:1.5px;
  margin:14px 0 8px;border-left:3px solid #6366f1;padding-left:8px;}
.sec-t:first-child{margin-top:0;}

/* 关卡卡片 */
.lv-card{display:flex;align-items:center;gap:12px;padding:13px;border-radius:14px;
  margin-bottom:9px;border:1.5px solid;position:relative;overflow:hidden;transition:.15s;}
.lv-card:active{transform:scale(.975);}
.lv-card.normal{background:linear-gradient(135deg,#132a1e,#0e1c16);border-color:#2e7d52;}
.lv-card.elite{background:linear-gradient(135deg,#1a1a35,#12122a);border-color:#5b4fc7;}
.lv-card.hell{background:linear-gradient(135deg,#2e1018,#1c0a10);border-color:#b52c3c;}
.lv-card.endless{background:linear-gradient(135deg,#0e2a35,#081820);border-color:#0891b2;}
.lv-icon{width:48px;height:48px;border-radius:12px;display:flex;align-items:center;
  justify-content:center;font-size:24px;flex:0 0 auto;background:rgba(0,0,0,.35);}
.lv-info{flex:1;min-width:0;}
.lv-name{font-size:14.5px;font-weight:900;margin-bottom:3px;letter-spacing:.5px;}
.lv-sub{font-size:10.5px;color:#7c8ab8;line-height:1.45;}
.lv-best{font-size:10px;font-weight:800;color:#fbbf24;margin-top:3px;}
.lv-go{padding:9px 15px;border-radius:10px;font-size:12px;font-weight:900;
  background:linear-gradient(180deg,#6366f1,#4338ca);color:#fff;border:none;flex:0 0 auto;}

/* 关卡选择网格 */
.stage-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:7px;margin-top:8px;}
.stage-cell{aspect-ratio:1/1;border-radius:9px;background:#12172c;border:1.5px solid #232c4e;
  display:flex;flex-direction:column;align-items:center;justify-content:center;gap:1px;
  font-size:12px;font-weight:900;color:#5c6a94;transition:.12s;}
.stage-cell.unlocked{background:#1a2140;border-color:#3d4a80;color:#c7d2fe;}
.stage-cell.cleared{background:linear-gradient(135deg,#1a3a2a,#132a1e);border-color:#4ade80;color:#4ade80;}
.stage-cell.current{background:linear-gradient(135deg,#3d2a6b,#2a1f4a);border-color:#a78bfa;color:#fff;
  box-shadow:0 0 12px rgba(167,139,250,.5);}
.stage-cell.locked{opacity:.35;}
.stage-cell .sc-best{font-size:7px;font-weight:700;color:#fbbf24;}
.stage-cell:active{transform:scale(.93);}

/* 英雄卡片 */
.hero-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;}
.hcard{background:#141a30;border:2px solid #232c4e;border-radius:12px;padding:9px 5px;
  text-align:center;position:relative;transition:.15s;}
.hcard.owned{border-color:#3d4a80;}
.hcard.sel{border-color:#fbbf24;box-shadow:0 0 14px rgba(251,191,36,.45);}
.hcard .hi{font-size:26px;line-height:1;}
.hcard .hn{font-size:10px;font-weight:800;margin-top:4px;color:#c7d2fe;
  overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
.hcard .hl{font-size:9px;font-weight:900;color:#fbbf24;margin-top:2px;}
.hcard .lock{position:absolute;inset:0;background:rgba(8,10,20,.78);border-radius:10px;
  display:flex;align-items:center;justify-content:center;font-size:18px;}

/* 英雄属性 */
.stat-row{display:flex;justify-content:space-between;padding:7px 11px;
  background:#141a30;border:1px solid #232c4e;border-radius:9px;margin-bottom:5px;
  font-size:12px;color:#8b9ac9;}
.stat-row b{color:#fff;font-weight:900;}
.stat-row .v{color:#fbbf24;}
.bonus-list{background:#12172c;border:1px solid #232c4e;border-radius:10px;
  padding:9px 11px;font-size:11px;line-height:1.9;color:#8b9ac9;}
.bonus-list .bl{color:#a5b4fc;font-weight:700;}

/* 通用按钮 */
.big-btn{width:100%;padding:13px;border-radius:13px;font-size:14px;font-weight:900;
  letter-spacing:1px;background:linear-gradient(90deg,#6366f1,#a855f7);color:#fff;
  border:none;margin-bottom:9px;box-shadow:0 4px 16px rgba(99,102,241,.4);transition:.12s;}
.big-btn:active{transform:scale(.97);}
.big-btn:disabled{background:#1a1f38;color:#3f4a70;box-shadow:none;}
.gacha-row{display:flex;gap:9px;}
.gacha-row .big-btn{flex:1;}

/* 商店升级 */
.shop-item{display:flex;align-items:center;gap:9px;background:#141a30;
  border:1px solid #232c4e;border-radius:12px;padding:10px 11px;margin-bottom:8px;}
.shop-item .si{font-size:21px;width:28px;text-align:center;flex:0 0 auto;}
.shop-item .sm{flex:1;min-width:0;}
.shop-item .st{font-size:12.5px;font-weight:800;color:#c7d2fe;}
.shop-item .ss{font-size:10px;color:#7c8ab8;margin-top:2px;}
.shop-item .slv{font-size:10px;color:#fbbf24;font-weight:800;}
.buy-group{display:flex;gap:4px;flex:0 0 auto;}
.buy-btn{padding:7px 9px;border-radius:8px;font-size:10.5px;font-weight:900;
  background:linear-gradient(180deg,#6366f1,#4338ca);color:#fff;border:none;white-space:nowrap;}
.buy-btn.max{background:linear-gradient(180deg,#f59e0b,#d97706);}
.buy-btn:disabled{background:#1a1f38;color:#3f4a70;}

/* ============ 战斗界面 ============ */
#battle{background:#070912;}
#cv{position:absolute;inset:0;width:100%;height:100%;display:block;}
.b-hud{position:absolute;top:0;left:0;right:0;padding:9px 11px;display:flex;gap:6px;
  align-items:center;z-index:5;pointer-events:none;}
.b-chip{background:rgba(12,16,32,.86);border:1px solid #2a3358;border-radius:9px;
  padding:5px 9px;font-size:11.5px;font-weight:800;backdrop-filter:blur(4px);}
#bWave{color:#a5b4fc;} #bGold{color:#ffd44d;} #bKill{color:#f87171;}
#bLv{color:#4ade80;margin-left:auto;}
#pauseBtn{position:absolute;top:9px;right:11px;width:34px;height:34px;border-radius:9px;
  background:rgba(12,16,32,.86);border:1px solid #2a3358;color:#a5b4fc;font-size:15px;z-index:6;}
#hpWrap{position:absolute;left:11px;right:11px;bottom:12px;height:16px;border-radius:9px;
  background:rgba(12,16,32,.9);border:1px solid #2a3358;overflow:hidden;z-index:5;}
#hpFill{height:100%;width:100%;border-radius:9px;
  background:linear-gradient(90deg,#ef4444,#f59e0b);transition:width .2s;}
#hpTxt{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;
  font-size:10px;font-weight:900;text-shadow:0 1px 2px #000;letter-spacing:.5px;}
#expWrap{position:absolute;left:11px;right:11px;bottom:32px;height:7px;border-radius:5px;
  background:rgba(12,16,32,.9);border:1px solid #2a3358;overflow:hidden;z-index:5;}
#expFill{height:100%;width:0%;background:linear-gradient(90deg,#22d3ee,#a855f7);
  transition:width .15s;box-shadow:0 0 8px rgba(168,85,247,.7);}
#bMsg{position:absolute;left:0;right:0;top:34%;text-align:center;font-size:22px;
  font-weight:900;color:#fff;opacity:0;pointer-events:none;letter-spacing:2px;
  text-shadow:0 0 22px #6366f1,0 3px 8px #000;z-index:6;}
#bMsg.show{animation:bm 1.5s ease-out;}
@keyframes bm{0%{opacity:0;transform:scale(1.6)}18%{opacity:1;transform:scale(1)}
  72%{opacity:1;transform:scale(1)}100%{opacity:0;transform:scale(.9)}}

/* 三选一 */
#lvlUp{position:absolute;inset:0;background:rgba(5,7,14,.92);z-index:20;
  display:none;flex-direction:column;align-items:center;justify-content:center;
  padding:22px;backdrop-filter:blur(6px);}
#lvlUp.show{display:flex;}
#lvlUp .lt{font-size:19px;font-weight:900;color:#fbbf24;letter-spacing:3px;margin-bottom:6px;}
#lvlUp .ls{font-size:11.5px;color:#7c8ab8;margin-bottom:20px;}
.up-list{width:100%;max-width:380px;display:flex;flex-direction:column;gap:11px;}
.up-card{display:flex;align-items:center;gap:13px;padding:14px;border-radius:14px;
  background:linear-gradient(135deg,#1a2140,#12172c);border:2px solid #3d4a80;
  transition:.13s;animation:upIn .28s cubic-bezier(.2,1.3,.5,1) backwards;}
.up-card:nth-child(2){animation-delay:.06s;}
.up-card:nth-child(3){animation-delay:.12s;}
@keyframes upIn{from{opacity:0;transform:translateY(22px) scale(.94)}}
.up-card:active{transform:scale(.96);}
.up-card .ui{width:46px;height:46px;border-radius:12px;display:flex;align-items:center;
  justify-content:center;font-size:24px;flex:0 0 auto;background:rgba(0,0,0,.35);}
.up-card .um{flex:1;min-width:0;}
.up-card .un{font-size:14px;font-weight:900;margin-bottom:3px;}
.up-card .ud{font-size:11px;color:#8b9ac9;line-height:1.4;}
.up-tag{font-size:9px;font-weight:900;padding:2px 7px;border-radius:6px;
  display:inline-block;margin-bottom:4px;}

/* 结算 */
#result{position:absolute;inset:0;background:rgba(5,7,14,.94);z-index:30;
  display:none;flex-direction:column;align-items:center;justify-content:center;
  padding:26px;backdrop-filter:blur(6px);}
#result.show{display:flex;}
.rz-box{width:100%;max-width:360px;background:linear-gradient(180deg,#1a2140,#0f1324);
  border:2px solid #3d4a80;border-radius:20px;padding:22px;
  box-shadow:0 12px 50px rgba(0,0,0,.9);}
.rz-title{text-align:center;font-size:22px;font-weight:900;margin-bottom:16px;
  letter-spacing:2px;}
.rz-title.win{color:#4ade80;text-shadow:0 0 20px rgba(74,222,128,.6);}
.rz-title.lose{color:#f87171;text-shadow:0 0 20px rgba(248,113,113,.6);}
.rz-row{display:flex;justify-content:space-between;font-size:12.5px;padding:7px 0;
  border-bottom:1px dashed #232c4e;color:#8b9ac9;}
.rz-row b{color:#fff;}
.rz-drops{margin-top:10px;font-size:11px;line-height:1.7;color:#fbbf24;
  max-height:110px;overflow-y:auto;}

/* 通用弹窗 */
.overlay{position:absolute;inset:0;background:rgba(5,7,14,.95);z-index:40;
  display:none;flex-direction:column;backdrop-filter:blur(6px);}
.overlay.show{display:flex;}
.ov-head{display:flex;align-items:center;gap:10px;padding:12px 14px;
  border-bottom:1px solid #232c4e;background:#11162a;}
.ov-head h2{font-size:15px;flex:1;color:#a5b4fc;letter-spacing:1px;}
.ov-head .res{font-size:12.5px;font-weight:900;color:#ffd44d;}
.closeX{width:32px;height:32px;border-radius:9px;background:#1a2140;border:1px solid #2f3a68;
  color:#a5b4fc;font-size:15px;font-weight:700;}
.ov-body{flex:1;overflow-y:auto;padding:12px 14px 26px;-webkit-overflow-scrolling:touch;}

#toast{position:absolute;left:50%;bottom:34%;transform:translateX(-50%);
  background:rgba(20,26,48,.97);border:1px solid #6366f1;color:#e0e7ff;
  padding:9px 18px;border-radius:11px;font-size:12px;font-weight:800;z-index:99;
  pointer-events:none;opacity:0;transition:opacity .25s;white-space:nowrap;}
#toast.show{opacity:1;}

.hint{font-size:10.5px;color:#5c6a94;line-height:1.7;padding:6px 2px;}
.empty{text-align:center;color:#3f4a70;font-size:12px;padding:28px 0;font-weight:700;}

.eq-slot-row{display:flex;gap:8px;margin-bottom:12px;}
.eq-slot{flex:1;background:#141a30;border:2px solid #232c4e;border-radius:11px;
  padding:9px 4px;text-align:center;transition:.13s;}
.eq-slot:active{transform:scale(.95);}
.eq-slot .esi{font-size:20px;}
.eq-slot .esn{font-size:8.5px;font-weight:800;margin-top:3px;color:#7c8ab8;
  overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
.eq-item{display:flex;align-items:center;gap:10px;background:#141a30;
  border:1px solid #232c4e;border-radius:11px;padding:9px 11px;margin-bottom:7px;}
.eq-item .ei{font-size:19px;width:26px;text-align:center;}
.eq-item .em{flex:1;min-width:0;}
.eq-item .en{font-size:12px;font-weight:800;}
.eq-item .ed{font-size:9.5px;color:#7c8ab8;margin-top:2px;}
.mini-b{padding:6px 10px;border-radius:8px;font-size:10px;font-weight:800;border:none;
  background:#2a3358;color:#c7d2fe;}
.mini-b.pri{background:linear-gradient(180deg,#6366f1,#4338ca);color:#fff;}
.mini-b.sell{background:#3a1a24;color:#fca5a5;}

.sell-row{display:flex;gap:7px;margin-top:10px;}
.sell-row .mini-b{flex:1;padding:11px;font-size:11px;border-radius:10px;}
.sell-row .mini-b.all{background:#7f1d1d;color:#fecaca;}
.sell-row .mini-b.common{background:#374151;color:#d1d5db;}
</style>
</head>
<body>
<div id="app">

  <!-- ============ 主界面 ============ -->
  <div id="menu" class="screen active">
    <div class="m-top">
      <div class="m-res">💰 <span id="mGold">0</span></div>
      <div class="m-res">💎 <span id="mGem">0</span></div>
    </div>

    <div class="m-hero" id="mHero">
      <div class="av" id="mHeroAv">❄️</div>
      <div class="info">
        <div class="hn" id="mHeroName">寒霜游侠</div>
        <div class="hd" id="mHeroDesc">雪塔伤害+35% · 减速效果+50%</div>
      </div>
      <div style="font-size:11px;font-weight:900;color:#fbbf24" id="mHeroLv">Lv.1</div>
    </div>

    <div class="m-tabs">
      <div class="m-tab on" data-tab="battle">⚔️ 战斗</div>
      <div class="m-tab" data-tab="hero">🦸 英雄</div>
      <div class="m-tab" data-tab="shop">🛒 商店</div>
    </div>

    <div class="m-body">
      <div id="tab-battle" class="tab-panel on"></div>
      <div id="tab-hero" class="tab-panel"></div>
      <div id="tab-shop" class="tab-panel"></div>
    </div>
  </div>

  <!-- ============ 战斗界面 ============ -->
  <div id="battle" class="screen">
    <canvas id="cv"></canvas>
    <div class="b-hud">
      <div class="b-chip" id="bWave">第 1 波</div>
      <div class="b-chip" id="bGold">💰 0</div>
      <div class="b-chip" id="bKill">☠️ 0</div>
      <div class="b-chip" id="bLv">Lv.1</div>
    </div>
    <button id="pauseBtn">⏸</button>
    <div id="expWrap"><div id="expFill"></div></div>
    <div id="hpWrap"><div id="hpFill"></div><div id="hpTxt">100 / 100</div></div>
    <div id="bMsg"></div>

    <div id="lvlUp">
      <div class="lt">升 级 !</div>
      <div class="ls">选择一项强化</div>
      <div class="up-list" id="upList"></div>
    </div>

    <div id="result">
      <div class="rz-box">
        <div class="rz-title" id="rzTitle">战斗胜利</div>
        <div id="rzRows"></div>
        <div class="rz-drops" id="rzDrops"></div>
        <button class="big-btn" id="rzBtn" style="margin-top:16px">返回主城</button>
      </div>
    </div>
  </div>

  <!-- ============ 弹窗 ============ -->
  <div class="overlay" id="ovPause">
    <div class="ov-head"><h2>暂停</h2><button class="closeX" data-close>✕</button></div>
    <div class="ov-body">
      <button class="big-btn" id="resumeBtn">▶ 继续战斗</button>
      <button class="big-btn" id="quitBtn" style="background:linear-gradient(90deg,#991b1b,#7f1d1d)">🏳️ 撤退结算</button>
      <div class="hint">撤退会保留已获得的金币与装备，但不会获得通关奖励。</div>
    </div>
  </div>

  <div class="overlay" id="ovStage">
    <div class="ov-head"><h2 id="stageTitle">选择关卡</h2>
      <button class="closeX" data-close>✕</button></div>
    <div class="ov-body" id="stageBody"></div>
  </div>

  <div class="overlay" id="ovGacha">
    <div class="ov-head"><h2>🎴 英雄召唤</h2>
      <div class="res">💰 <span class="goldV">0</span></div>
      <button class="closeX" data-close>✕</button></div>
    <div class="ov-body" id="gachaBody"></div>
  </div>

  <div class="overlay" id="ovBag">
    <div class="ov-head"><h2>🎒 装备背包</h2>
      <button class="closeX" data-close>✕</button></div>
    <div class="ov-body" id="bagBody"></div>
  </div>

  <div id="toast"></div>
</div>

<script>
/* ============================================================
   枪火塔防 · 兽潮无尽
   ============================================================ */
const $ = id => document.getElementById(id);
const rnd = (a,b)=>a+Math.random()*(b-a);
const ri  = (a,b)=>Math.floor(rnd(a,b+1));
const pick = a => a[Math.floor(Math.random()*a.length)];
const clamp=(v,a,b)=>Math.max(a,Math.min(b,v));

/* ============================================================
   英雄（6位）
   ============================================================ */
const HEROES = {
  frost:{
    id:'frost', name:'寒霜游侠', icon:'❄️', color:'#67e8f9', rarity:'common',
    desc:'雪塔伤害+35%，减速效果+50%',
    base:{hp:0, atk:0, rate:0, snowDmg:1.35, snowSlow:0.5},
    perLv:{hp:8, atk:1.2, snowDmg:0.06, snowSlow:0.04}
  },
  thunder:{
    id:'thunder', name:'雷霆枪手', icon:'⚡', color:'#a78bfa', rarity:'common',
    desc:'雷塔连锁+1，枪射速+15%',
    base:{hp:0, atk:0, rate:0.15, chain:1, thunderDmg:1.1},
    perLv:{hp:6, atk:1.4, rate:0.015, thunderDmg:0.05}
  },
  blaze:{
    id:'blaze', name:'烈焰炮手', icon:'🔥', color:'#fb923c', rarity:'rare',
    desc:'火塔灼烧伤害翻倍，枪攻击+20%',
    base:{hp:0, atk:0.20, fireDmg:1.2, fireBurn:1.0},
    perLv:{hp:7, atk:0.025, fireDmg:0.07, fireBurn:0.08}
  },
  guard:{
    id:'guard', name:'铁壁守卫', icon:'🛡️', color:'#60a5fa', rarity:'rare',
    desc:'生命上限+70，所有塔伤害+22%',
    base:{hp:70, towerDmg:0.22, atk:0, rate:0},
    perLv:{hp:14, towerDmg:0.03}
  },
  shadow:{
